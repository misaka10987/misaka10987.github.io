---
import config from '@/config'
import { url } from '../utils/url-utils'
import Link from './Link'

interface Props {
  class?: string
}

const currentYear = new Date().getFullYear()

const { class: className } = Astro.props
---

<style>
footer {
  animation-delay: 250ms;
}
</style>

<footer class={className}>
  <div
    class="transition border-t border-black/10 dark:border-white/15 my-10 border-dashed mx-32"
  />
  <div
    class="transition border-dashed border-[oklch(85%_0.01_var(--hue))] dark:border-white/15 rounded-2xl mb-12 flex flex-col items-center justify-center px-6"
  >
    <div class="transition text-50 text-sm text-center">
      &copy; <span>{currentYear}</span>
      {' '}{config.profile.name}. All Rights Reserved. /{' '}
      <Link
        class="transition text-[var(--primary)] font-medium"
        href={url('rss.xml')}
        >RSS</Link
      >
      {' '}/{' '}
      <Link
        class="transition text-[var(--primary)] font-medium"
        target="_blank"
        href={url('sitemap-index.xml')}
        >Sitemap</Link
      >
      <br>
      <Link
        class="transition text-[var(--primary)] font-medium"
        href="https://icp.gov.moe/?keyword=20240987"
        target="_blank"
        >萌ICP备20240987号</Link
      >
      <br>
      Powered by{' '}
      <Link
        class="transition text-[var(--primary)] font-medium"
        target="_blank"
        href="https://astro.build"
        >Astro</Link
      >
      {' '}&{' '}
      <Link
        class="transition text-[var(--primary)] font-medium"
        target="_blank"
        href="https://github.com/saicaca/fuwari"
        >Fuwari</Link
      >
    </div>
  </div>
</footer>
