---
import { Inlay } from '@components/fiberglass/Inlay'

interface Props {
  badge?: string
  url?: string
  label?: string
}
const { badge, url, label } = Astro.props
---

<a href={url} aria-label={label}>
  <button
    type="button"
    class:list={`
            w-full
            h-10
            rounded-lg
            bg-none
            group
            transition-all
            pl-2
            text-neutral-700
            hover:text-[var(--primary)]
            dark:text-neutral-300
            dark:hover:text-[var(--primary)]
            active:scale-95
        `}
  >
    <div class="flex items-center justify-between relative mr-2">
      <div
        class="overflow-hidden text-left whitespace-nowrap overflow-ellipsis group-hover:underline group-hover:underline-offset-4"
      >
        <slot></slot>
      </div>
      {badge !== undefined && badge !== null && badge !== '' && (
        <Inlay class="px-2 h-7 ml-4 min-w-8 text-sm font-bold text-black dark:text-white">
          {badge}
        </Inlay>
      )}
    </div>
  </button>
</a>
