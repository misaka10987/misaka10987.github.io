---
import FiberglassButton from '@components/fiberglass/Button'

interface Props {
  size?: string
  dot?: boolean
  href?: string
  label?: string
}
const { dot, href, label }: Props = Astro.props
---

<FiberglassButton
  as="a"
  variant="regular"
  href={href}
  aria-label={label}
  class="h-6 text-sm font-bold px-3"
>
  {dot && (
      <div class="h-1 w-1 bg-[var(--btn-content)] dark:bg-[var(--card-bg)] transition rounded-md mr-2" />
    )}
  <slot />
</FiberglassButton>
