---
import config from '@/config'
import { MORSE_CODE } from '@/lib/morse'

const { message, dotMilliseconds } = config.needleSignal
const words = message
  .toUpperCase()
  .trim()
  .split(/\s+/)
  .map((word) => Array.from(word, (c) => MORSE_CODE[c]).filter(Boolean))
  .filter((word) => word.length)

// All timing is in dots. The seven-dot gap also separates repetitions.
let units = 0
const frames = [{ time: 0, opacity: 0.55 }]
for (const word of words) {
  for (const letter of word) {
    for (const mark of letter) {
      const end = units + (mark === '.' ? 1 : 3)
      frames.push(
        { time: units, opacity: 0.55 },
        { time: units + 0.45, opacity: 1 },
        { time: end - 0.45, opacity: 1 },
        { time: end, opacity: 0.55 },
      )
      units = end + 1
    }
    units += 2
  }
  units += 4
}
const keyframes = units
  ? frames
      .map(
        ({ time, opacity }) => `${(100 * time) / units}%{opacity:${opacity}}`,
      )
      .join('')
  : ''
---

<style
  is:inline
  set:html={`@keyframes needle-cw{${keyframes}100%{opacity:.55}}`}
/>
<svg
  class="hidden lg:flex absolute w-full h-[calc(100%-var(--needle-start))] overflow-hidden pointer-events-none -z-10 needle-field transition-transform duration-700"
  style={units && dotMilliseconds > 0
    ? `--period:${units * dotMilliseconds}ms`
    : undefined}
  aria-hidden="true"
  focusable="false"
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
>
  <path stroke-width="4" opacity=".55" />
  <path stroke-width="6" />
</svg>
<script is:inline>
;(() => {
  const field = document.currentScript.previousElementSibling
  const groups = []
  const render = () => {
    if (!field.isConnected) {
      observer.disconnect()
      window.removeEventListener('resize', render)
      return
    }
    const width = field.clientWidth
    const screen = Math.max(1, window.innerHeight)
    const count = Math.ceil(field.clientHeight / screen)
    while (groups.length < count) {
      groups.push(
        Array.from({ length: 32 }, () => ({
          x: Math.random(),
          y: Math.random(),
          angle: Math.random() * Math.PI,
          length: 320 + Math.random() * 360,
        })),
      )
    }
    const scale = Math.max(width / 1200, screen / 800)
    const paths = [[], []]
    for (let group = 0; group < count; group++) {
      groups[group].forEach((needle, i) => {
        const dx = needle.length * scale * Math.cos(needle.angle)
        const dy = needle.length * scale * Math.sin(needle.angle)
        const x = needle.x * width - dx / 2
        const y = (group + needle.y) * screen - dy / 2
        paths[i % 2].push(
          `M${x.toFixed(1)} ${y.toFixed(1)}l${dx.toFixed(1)} ${dy.toFixed(1)}`,
        )
      })
    }
    paths.forEach((segments, i) => {
      field.children[i].setAttribute('d', segments.join(''))
      field.children[i].setAttribute('stroke-width', (i ? 6 : 4) * scale)
    })
  }
  const observer = new ResizeObserver(render)
  observer.observe(field)
  window.addEventListener('resize', render)
})()
</script>

<style>
.needle-field {
  inset: var(--needle-start) 0 auto;

  color: color-mix(in oklab, var(--primary), var(--page-bg));
}
@media (prefers-reduced-motion: no-preference) {
  .needle-field[style] {
    animation: needle-cw var(--period) ease-in-out infinite;
  }
}
</style>
