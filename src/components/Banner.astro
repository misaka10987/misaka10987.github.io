---
import config from '@/config'
import { BANNER_HEIGHT_EXTEND } from '@constants/constants'
import ImageWrapper from './misc/ImageWrapper.astro'
---

{config.banner.enable && (
    <div
      id="banner-wrapper"
      class={`absolute z-10 w-full transition duration-700 overflow-hidden`}
      style={`top: -${BANNER_HEIGHT_EXTEND}vh`}
    >
      <ImageWrapper
        id="banner"
        alt="Banner image of the blog"
        class:list={[
          'object-cover h-full transition duration-700 opacity-0 scale-105 select-none',
        ]}
        src={config.banner.src}
        position={config.banner.position}
      />
    </div>
  )}
