---
import { getCollection, render } from 'astro:content'
import Markdown from '@components/misc/Markdown.astro'
import MainGridLayout from '../layouts/MainGridLayout.astro'
import Card from '@components/Card'
import type { GetStaticPaths } from 'astro'
import config from '@/config'

export const getStaticPaths = (async () => {
  const entries = await getCollection('spec', (entry) =>
    config.specialPage.includes(entry.id),
  )

  return entries.map((entry) => ({
    params: {
      spec: entry.id,
    },
    props: {
      entry,
    },
  }))
}) satisfies GetStaticPaths

const { entry } = Astro.props

if (!entry) {
  throw new Error('About page content not found')
}

const { Content } = await render(entry)
---

<MainGridLayout title={entry.data.title} description={entry.data.description}>
  <div
    class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32"
  >
    <Card class="z-10 px-9 py-6 relative w-full">
      <Markdown class="mt-2">
        <Content />
      </Markdown>
    </Card>
  </div>
</MainGridLayout>
